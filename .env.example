# ==============================================================================
# BẾP DÌ 6 - PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Sao chép file này thành .env và điền các thông tin thực tế:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core & Security Settings
# ------------------------------------------------------------------------------
# Đặt False khi chạy Production trên Home Server / VPS
DEBUG=False

# Tạo chuỗi secret key bảo mật ngẫu nhiên (dài >= 50 ký tự)
SECRET_KEY=django-insecure-replace-this-with-a-strong-random-secret-key-for-prod

# Danh sách host được phép gọi tới (ngăn chặn HTTP Host Header Attacks)
# Điền IP nội bộ, localhost và Subdomain Cloudflare của bạn (VD: api.bepdi6.vn)
ALLOWED_HOSTS=localhost,127.0.0.1,api.bepdi6.vn,.trycloudflare.com

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_DB=bepdi6_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Khi chạy qua docker-compose.prod.yml, container tự dùng host "postgres"
# Chuỗi kết nối trực tiếp (khi chạy local/test ngoài container):
DATABASE_URL=postgres://postgres:your_secure_postgres_password_here@localhost:5432/bepdi6_db

# ------------------------------------------------------------------------------
# 3. Redis Cache & Celery Task Queue
# ------------------------------------------------------------------------------
# Khi chạy qua docker-compose.prod.yml, container tự dùng host "redis"
# Chuỗi kết nối trực tiếp (khi chạy local/test ngoài container):
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. Cloudflare Tunnel (Zero-Open-Ports Ingress)
# ------------------------------------------------------------------------------
# Lấy từ Cloudflare Zero Trust Dashboard > Networks > Tunnels > Create Tunnel
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...dien_token_tunnel_cua_ban_tai_day...

# ------------------------------------------------------------------------------
# 5. CORS Settings (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
# Danh sách các origin được phép gọi API (phân tách bởi dấu phẩy)
# h5.zdn.vn và zbrowser://h5.zdn.vn là bắt buộc cho Zalo Mini App
CORS_ALLOWED_ORIGINS=https://h5.zdn.vn,zbrowser://h5.zdn.vn

# ------------------------------------------------------------------------------
# 6. Cloudflare R2 Media Storage (Zero-Egress Object Storage)
# ------------------------------------------------------------------------------
# Bật True để tải ảnh món ăn trực tiếp từ Cloudflare R2 CDN (không nghẽn mạng nhà)
USE_S3_STORAGE=True
AWS_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
AWS_STORAGE_BUCKET_NAME=bepdi6-media
AWS_S3_ENDPOINT_URL=https://<your_cloudflare_account_id>.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=pub-<your_r2_subdomain>.r2.dev

# ------------------------------------------------------------------------------
# 7. Notification Services (Telegram & Zalo OA)
# ------------------------------------------------------------------------------
# Thông báo đơn mới cho nhân viên / bếp qua Telegram (Miễn phí, <1s realtime)
ENABLE_TELEGRAM_NOTIFICATION=True
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Thông báo Zalo OA & ZNS
ZALO_APP_ID=your_zalo_app_id
ZALO_APP_SECRET=your_zalo_app_secret
ZALO_OA_ID=your_zalo_oa_id
ZALO_OA_SECRET=your_zalo_oa_secret
ZALO_OA_ACCESS_TOKEN=your_zalo_oa_access_token
ENABLE_ZNS_NOTIFICATION=False

# ------------------------------------------------------------------------------
# 8. Cấu hình Cửa Hàng & Vận Chuyển (Shipping)
# ------------------------------------------------------------------------------
SHOP_LATITUDE=10.7769
SHOP_LONGITUDE=106.7009
MAX_DELIVERY_RADIUS_KM=7.0
HAVERSINE_MULTIPLIER=1.3

# ------------------------------------------------------------------------------
# 9. Thanh Toán VietQR Tự Động
# ------------------------------------------------------------------------------
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0987654321
VIETQR_ACCOUNT_NAME=BEP DI 6
