# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-change-this-in-production-bepdi6-zalo-miniapp
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bepdi6_db

# Redis Cache & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# Zalo OpenAPI & ZNS Configuration
ZALO_APP_ID=your_zalo_app_id
ZALO_APP_SECRET=your_zalo_app_secret
ZALO_OA_ID=your_zalo_oa_id
ZALO_OA_SECRET=your_zalo_oa_secret
ZALO_OA_ACCESS_TOKEN=your_zalo_oa_access_token

# Feature Flags
ENABLE_ZNS_NOTIFICATION=False

# Storage Configuration (Cloudflare R2 / AWS S3)
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=your_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key
AWS_STORAGE_BUCKET_NAME=bepdi6-media
AWS_S3_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=pub-your-id.r2.dev

# Shop Location & Shipping (Haversine multiplier)
SHOP_LATITUDE=10.7769
SHOP_LONGITUDE=106.7009
MAX_DELIVERY_RADIUS_KM=7.0
HAVERSINE_MULTIPLIER=1.3

# VietQR Configuration
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0987654321
VIETQR_ACCOUNT_NAME=BEP DI 6

